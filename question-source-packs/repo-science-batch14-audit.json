    {
      "id": "SCI-REPO-Y8-SBY-2018-SYSTEMS-MC03",
      "note": "Supplied key incorrectly selects platelets for haemophilia; plasma clotting-factor deficiency is the relevant mechanism. See CDChttps://www.cdc.gov/hemophilia/about/."
    },
    {
      "id": "SCI-REPO-Y8-SBY-2018-SYSTEMS-MC07",
      "note": "Two correct options A and D are explicitly marked in supplied key."
    },
    {
      "id": "SCI-REPO-Y8-SBY-2018-SYSTEMS-MC08",
      "note": "Definition in terms of parent count is incomplete and excludes self-fertilisation."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-ENDOCRINE-MC05",
      "note": "Supplied key confuses first-line breach with second-line response."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-ENDOCRINE-MC09",
      "note": "Source uses quarantine for known infection; isolation is the appropriate general distinction."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-ENDOCRINE-MC10",
      "note": "Vaccine availability is date-dependent; influenza and Ebola both have vaccines now. Historical source retained manually."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-ENDOCRINE-14",
      "note": "Historical drug list is not a current prescribing guide. Assess conceptual severity-appropriate examples; reviewed against NHShttps://www.nhs.uk/conditions/allergies/ andhttps://www.nhs.uk/conditions/anaphylaxis/."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-MC04",
      "note": "No dated reconstruction map provided; India’s neighbours depend on reconstruction."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-MC06",
      "note": "Imprecise heat-generation premise; teacher clarification needed."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-MC07",
      "note": "Supplied key A contradicts valid magnetic-striping evidence, and Bwording is ambiguous."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-11b",
      "note": "Supplied key says patterns of magnesium; corrected to remanent magnetic polarity."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-12",
      "note": "Supplied guide mixes lithosphere(mechanical layer)with mantle/core(compositional layers)."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-TECTONICS-13",
      "note": "Task asks ten major plates, while guide accepts major/minor; clarify convention and do not require ten universally classified major plates."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2018-EARTH-MC07",
      "note": "No option precisely defines global warming; Bdescribes a cause rather than the definition."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2018-EARTH-MC08",
      "note": "Option Bcontains false claim that photosynthesis traps heat; key corrects CO₂roles."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2018-EARTH-MC09",
      "note": "B and C can both describe ocean heat transport."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2018-EARTH-B1",
      "note": "Historical word bank retained; the“single point”andunchangingsteadystatewording are simplified and must not be taught as necessary current cosmology."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2018-EARTH-B5b",
      "note": "Supplied key omits the two consecutive years criterion for permafrost."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2016-FORENSIC-MC04",
      "note": "Legal procedure depends on jurisdiction/context; historical curriculum item retained manual."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2016-FORENSIC-MC14",
      "note": "Absolute claim about DNA in every cell nucleus is false."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2016-FORENSIC-MC15",
      "note": "Multiple listed types of evidence can help identify a body."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2016-FORENSIC-MC17",
      "note": "Und ated population general isa tion; not appropriate for automatic current-facts coring."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-SPORT-MC03",
      "note": "Source compares whole blood with one of its own components; correct formed-elements/plasma interpretation provided."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-SPORT-MC05",
      "note": "Historical clinical reference with context-dependent thresholds; retained manual."
