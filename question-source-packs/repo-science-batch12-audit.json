      "note": "More than one description can be correct, and supplied keys disagree across variants."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-MC07",
      "note": "At least two statements are false; not a valid single-answer MC."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-MC12",
      "note": "Both C and D describe a community."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-MC15",
      "note": "Supplied key confuses heat with temperature; correct energy-transfer explanation provided."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-MC18",
      "note": "Charge carriers depend on medium; electrons in metal wires and ions in electrolytes."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-26b",
      "note": "Supplied key incorrectly defines strength using danger and edibility. Replaced with ionisation-based guidance."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2017-EXT-33",
      "note": "Supplied key wrongly calls the vacuum a layer of air. Figure text already explains reflection; original figure preserved and answer is manually marked."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-MC10",
      "note": "Supplied key marks sons only, but question asks allele inheritance: all children inherit maternal allele."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-MC23",
      "note": "Direction convention is unstated; negative acceleration need not mean slowing."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-MC28",
      "note": "Original optionB has no numerical value; teacher must repair incomplete distractor."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-19",
      "note": "Source and key ignore the downhill gravitational component. Accept−1.8m/s² only under the stated friction-only/resultant-force assumption; accept a correct underdetermination explanation."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-20b",
      "note": "Supplied key substitutes inconsistent values and reports20J. Original task gives2kg,9.8N/kg and2m, yielding39.2J."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-24b",
      "note": "Supplied key incorrectly namesCO as carbon dioxide; corrected to carbon monoxide."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-EXT-28option1",
      "note": "Original optional10mark response retained separately. Supplied key wrongly generalises all covalent solids as malleable, soft and low-melting; correct molecular/network distinction accepted."
    },
    {
      "id": "SCI-REPO-Y10-ARAN-2015-S1CHEM-MC18",
      "note": "A is universally valid; D includes mechanism-specific claims that are not general. Teacher review required."
