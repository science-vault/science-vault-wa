      "id": "SCI-REPO-Y10-SBY-2017-S1EXAM-MC21",
      "note": "The question omits whether the chromosome has replicated;two chromatids is not always true."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-S1EXAM-2b",
      "note": "Corrected supplied key:meiosis normally gives four products,not three;gametes are products,not the site of meiosis."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-S1EXAM-4e",
      "note": "Supplied key gives25% for dimples;corrected to75% under the stated dominant model."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-S1EXAM-5a",
      "note": "Source confuses band extension/variable force with the distance the released band travels. Do not present25J as uniquely inferable."
    },
    {
      "id": "SCI-REPO-Y10-SBY-2017-S1EXAM-5e",
      "note": "Supplied key uses firefighter mass for cat;correct answer75J."
    },
    {
      "id": "SCI-REPO-Y9-SBY-2020-S2EXAM-MC17",
      "note": "All options falsely say S-waves travel through solids,liquids and gases;teacher review required."
