[{"id":"maths-lower-data-910-data-interpretation-short-q2","subject":"Mathematics","area":"Mathematics","year":7,"originalYear":9,"examYear":0,"units":"Lower school","number":2,"sourceNumber":"2","sourceSection":"Short answer","source":"Data Interpretation · Short answer","section":"Calculator-assumed","types":["Calculator-assumed"],"calculatorMode":"assumed","responseTypes":["Short answer"],"marks":1,"marksOrigin":"Practice allocation; no printed question marks in source","topics":["Statistics and data"],"subtopics":["Dot plots"],"mixed":false,"text":"The dot plot shows scores out of 10 on a magazine quiz. How many friends took the quiz?","hash":"28e6d2b480b69c0f473af6fcf4586baeee688d3d76a5520b8ad99224776c5a69","sourceFile":"Data Interpretation Test.docx","sourcePage":1,"sourceKeyFile":"Answers 9 10 Data.pdf","sourceKeyPage":6,"bankFile":"practice-studio-mathematics-data-interpretation-data910.json","addedAt":"2026-10-31T01:10:22Z","solutionOrigin":"supplied-key-checked-with-independent-calculation","scsa":{"curriculum":"Western Australian Curriculum Mathematics 2026","strand":"Probability and statistics","subStrand":"Probability and statistics","year":7,"foundation":true,"optional":false,"url":"https://k10outline.scsa.wa.edu.au/__data/assets/pdf_file/0004/1229467/Mathematics_Scope-and-sequence_7-10__For-implementation-in-2026.PDF"},"figures":1,"markingKeyPoints":[],"html":"<p>The dot plot shows scores out of 10 on a magazine quiz.</p><figure><img alt=\"Dot plot of scores out of 10\" src=\"assets/practice-mathematics/data910-8c8c6de141621893.png\"></figure><p>How many friends took the quiz?</p>","answerHtml":"<h3>Worked solution</h3><p>Count the dots: 2 + 3 + 3 + 4 + 3 + 1 = 16.</p><h3>Marking guidance</h3><p>Award practice credit for the correct result(s), with a valid method. Equivalent valid methods are accepted.</p><p>Marks are practice allocations; the source did not print a mark allocation for each question.</p>","sourceData":{"5":2,"6":3,"7":3,"8":4,"9":3,"1