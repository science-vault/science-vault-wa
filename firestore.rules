rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function member() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
  function active() { return signedIn() && member().status == 'active' && member().registrationVersion == 2; }
  function student() { return active() && member().role == 'student'; }
  function teacher() { return active() && member().role == 'teacher' && request.auth.token.email_verified == true && member().permissions.get('teacher-classes.html',true) == true; }
  function isAdmin() { return signedIn() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
  function room(code) { return get(/databases/$(database)/documents/classes/$(code)).data; }
  function owner(code) { return teacher() && room(code).ownerUid == request.auth.uid; }
  function ownerActive(code) { let p = get(/databases/$(database)/documents/members/$(room(code).ownerUid)).data; return p.role == 'teacher' && p.status == 'active' && p.registrationVersion == 2 && p.permissions.get('teacher-classes.html',true) == true; }
  function enrolled(code) { return student() && ownerActive(code) && exists(/databases/$(database)/documents/classes/$(code)/students/$(request.auth.uid)); }
  function validMember(d) {
   return d.keys().hasOnly(['email','displayName','role','status','permissions','registrationVersion','yearGroup','subjects','classCode','createdAt','updatedAt'])
    && d.keys().hasAll(['email','displayName','role','status','permissions','registrationVersion','yearGroup','subjects','classCode','createdAt','updatedAt'])
    && d.email == request.auth.token.email && d.displayName is string && d.displayName.size() <= 60
    && d.role in ['student','teacher'] && d.status == 'pending' && d.permissions == {} && d.registrationVersion == 2
    && d.classCode is string && (d.classCode == '' || d.classCode.matches('^[A-HJ-NP-Z2-9]{8}$'))
    && d.subjects is list && d.subjects.toSet().size() == d.subjects.size()
    && ((d.role == 'teacher' && d.yearGroup == 0 && d.subjects == [] && d.classCode.size() == 8)
     || (d.role == 'student' && d.yearGroup in [7,8,9,10,11,12]
      && ((d.yearGroup <= 10 && d.subjects == []) || (d.yearGroup >= 11 && d.subjects.size() >= 4 && d.subjects.size() <= 5
       && d.subjects.hasOnly(['Geography ATAR','Business Management and Enterprise ATAR','Accounting and Finance ATAR','Physics ATAR','Chemistry ATAR','Biology ATAR','Human Biology ATAR','Psychology ATAR','Mathematics Methods ATAR','Mathematics Specialist ATAR','Mathematics Applications ATAR','English ATAR','Physical Education Studies ATAR'])))))
    && d.updatedAt == request.time;
  }
  match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
  match /members/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow list: if isAdmin();
   allow create: if signedIn() && request.auth.uid == uid && validMember(request.resource.data) && request.resource.data.createdAt == request.time;
   allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','permissions','updatedAt']) && request.resource.data.status in ['active','pending','suspended'] && request.resource.data.permissions is map && request.resource.data.permissions.size() <= 500 && request.resource.data.updatedAt == request.time)
    || (signedIn() && request.auth.uid == uid && resource.data.get('registrationVersion',0) < 2 && request.resource.data.role == resource.data.role && request.resource.data.createdAt == resource.data.createdAt && validMember(request.resource.data));
   allow delete: if false;
   // A user's saved lesson sequence, current slide and drafts.
   match /lessonJourneys/{lessonId} {
    allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
    allow create, update: if signedIn() && request.auth.uid == uid && (isAdmin() || active())
     && request.resource.data.keys().hasOnly(['version','total','index','completed','masterPassed','started','attempt','completedOnce','drafts','updatedMs','course','year','unit','topic','title','updatedAt'])
     && request.resource.data.version == 1
     && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 2000
     && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index <= request.resource.data.total
     && request.resource.data.completed is list && request.resource.data.completed.size() <= request.resource.data.total
     && request.resource.data.completed.toSet().size() == request.resource.data.completed.size()
     && request.resource.data.masterPassed is bool && request.resource.data.started is bool && request.resource.data.completedOnce is bool
     && (!request.resource.data.masterPassed || request.resource.data.completed.size() == request.resource.data.total)
     && request.resource.data.attempt is int && request.resource.data.attempt >= 0 && request.resource.data.attempt <= 1000000
     && request.resource.data.drafts is map && request.resource.data.drafts.size() <= 2001
     && request.resource.data.updatedMs is number && request.resource.data.updatedMs >= 0
     && request.resource.data.course is string && request.resource.data.course.size() <= 120
     && request.resource.data.year in [7,8,9,10,11,12]
     && request.resource.data.unit is string && request.resource.data.unit.size() <= 160
     && request.resource.data.topic is string && request.resource.data.topic.size() <= 160
     && request.resource.data.title is string && request.resource.data.title.size() <= 180
     && request.resource.data.updatedAt == request.time;
    allow delete: if false;
   }
   match /enrollments/{code} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create, update: if student() && request.auth.uid == uid && member().permissions.get('student-classes.html',true) == true
     && request.resource.data.keys().hasOnly(['classCode','joinedAt']) && request.resource.data.classCode == code && request.resource.data.joinedAt == request.time
     && existsAfter(/databases/$(database)/documents/classes/$(code)/students/$(uid));
    allow delete: if false;
   }
  }
  match /classes/{code} {
   // The code is a shareable invitation. This document contains no student records.
   allow get: if signedIn();
   allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid','name','code','createdAt'])
    && request.resource.data.ownerUid == request.auth.uid && request.resource.data.code == code && code.matches('^[A-HJ-NP-Z2-9]{8}$')
    && request.resource.data.name is string && request.resource.data.name.size() <= 120 && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'teacher'
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.classCode == code;
   allow update, delete: if false;
   match /students/{uid} {
    allow get: if owner(code) || isAdmin() || (student() && uid == request.auth.uid);
    allow list: if owner(code) || isAdmin();
    allow create, update: if student() && request.auth.uid == uid && ownerActive(code) && member().permissions.get('student-classes.html',true) == true
     && request.resource.data.keys().hasOnly(['studentUid','displayName','yearGroup','joinedAt']) && request.resource.data.studentUid == uid
     && request.resource.data.displayName == member().displayName && request.resource.data.yearGroup == member().yearGroup && request.resource.data.joinedAt == request.time;
    allow delete: if false;
   }
   // Student-controlled lesson summary shared only with the owning teacher and the student.
   // No drafts, answers, browsing events, or email addresses are stored here.
   match /lessonSummaries/{summaryId} {
    allow read: if owner(code) || isAdmin() || (enrolled(code) && resource.data.studentUid == request.auth.uid);
    allow create, update: if enrolled(code) && request.resource.data.keys().hasOnly(['studentUid','title','course','year','unit','topic','completed','total','completedOnce','updatedAt'])
     && request.resource.data.studentUid == request.auth.uid
     && request.resource.data.title is string && request.resource.data.title.size() <= 180
     && request.resource.data.course is string && request.resource.data.course.size() <= 120
     && request.resource.data.year == member().yearGroup
     && request.resource.data.unit is string && request.resource.data.unit.size() <= 160
     && request.resource.data.topic is string && request.resource.data.topic.size() <= 160
     && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 2000
     && request.resource.data.completed is int && request.resource.data.completed >= 0 && request.resource.data.completed <= request.resource.data.total
     && request.resource.data.completedOnce is bool && request.resource.data.updatedAt == request.time;
    allow delete: if false;
   }
   // Class-only participation leaderboard. No email, answers or school marks are shared.
   match /leaderboard/{uid} {
    allow read: if owner(code) || enrolled(code) || isAdmin();
    allow create, update: if enrolled(code) && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['displayName','xp','level','updatedAt'])
     && request.resource.data.displayName == member().displayName
     && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000000
     && request.resource.data.level is int && request.resource.data.level == int(request.resource.data.xp / 250) + 1
     && request.resource.data.updatedAt == request.time
     && (!exists(/databases/$(database)/documents/classes/$(code)/leaderboard/$(uid)) || request.resource.data.xp >= resource.data.xp);
    allow delete: if false;
   }
   match /tasks/{taskId} {
    allow read: if owner(code) || enrolled(code) || isAdmin();
    allow create: if owner(code) && request.resource.data.keys().hasOnly(['title','kind','course','yearGroup','unit','topic','instructions','dueDate','minutes','questionIds','url','ownerUid','createdAt'])
     && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
     && request.resource.data.kind in ['lesson','practice','assessment'] && request.resource.data.yearGroup in [7,8,9,10,11,12]
     && request.resource.data.course is string && request.resource.data.course.size() <= 120
     && request.resource.data.unit is string && request.resource.data.unit.size() <= 120 && request.resource.data.topic is string && request.resource.data.topic.size() <= 120
     && request.resource.data.instructions is string && request.resource.data.instructions.size() <= 2000
     && request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 10
     && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 180
     && request.resource.data.questionIds is list && request.resource.data.questionIds.size() <= 50
     && (request.resource.data.kind != 'assessment' || request.resource.data.questionIds.size() > 0)
     && request.resource.data.url is string && request.resource.data.url.size() <= 1500 && request.resource.data.url.matches('^(topic-hub|student-quiz)\\.html(\\?.*)?$');
    allow update: if owner(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','instructions','dueDate','minutes','topic','unit']) && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 && request.resource.data.instructions is string && request.resource.data.instructions.size() <= 2000 && request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 10 && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 180 && request.resource.data.topic is string && request.resource.data.topic.size() <= 120 && request.resource.data.unit is string && request.resource.data.unit.size() <= 120;
    allow delete: if owner(code);
   }
   match /progress/{attemptId} {
    allow read: if owner(code) || isAdmin() || (enrolled(code) && resource.data.studentUid == request.auth.uid);
    allow create: if enrolled(code) && request.resource.data.keys().hasOnly(['studentUid','taskId','kind','title','course','yearGroup','earned','max','manualCount','completed','selfReported','seconds','responses','createdAt'])
     && request.resource.data.studentUid == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.kind in ['quiz','lesson'] && request.resource.data.yearGroup == member().yearGroup
     && request.resource.data.course is string && request.resource.data.course.size() <= 120 && (member().yearGroup <= 10 || request.resource.data.course in member().subjects)
     && request.resource.data.title is string && request.resource.data.title.size() <= 120
     && request.resource.data.earned is number && request.resource.data.max is number && request.resource.data.earned >= 0 && request.resource.data.earned <= request.resource.data.max && request.resource.data.max <= 10000
     && request.resource.data.manualCount is int && request.resource.data.manualCount >= 0 && request.resource.data.manualCount <= 100
     && request.resource.data.completed is bool && request.resource.data.selfReported is bool && request.resource.data.seconds is int && request.resource.data.seconds >= 0 && request.resource.data.seconds <= 86400
     && request.resource.data.responses is list && request.resource.data.responses.size() <= 50 && request.resource.data.taskId is string
     && member().permissions.get(request.resource.data.kind == 'quiz' ? 'student-quiz.html' : 'topic-hub.html',true) == true
     && (request.resource.data.taskId == '' || (get(/databases/$(database)/documents/classes/$(code)/tasks/$(request.resource.data.taskId)).data.yearGroup == request.resource.data.yearGroup && get(/databases/$(database)/documents/classes/$(code)/tasks/$(request.resource.data.taskId)).data.course == request.resource.data.course));
    allow update, delete: if false;
   }
  }
  // Quiz Battle: class-bound rooms, immutable server-timed answers, teacher scoring.
  function battle(code) { return get(/databases/$(database)/documents/quizBattles/$(code)).data; }
  function battleFresh(d) { return request.time < d.createdAt + duration.value(12,'h'); }
  function battleStudent(d) { return enrolled(d.classCode) && member().permissions.get('quiz-battle.html',true) == true && member().yearGroup == d.yearGroup && (d.yearGroup <= 10 || d.course in member().subjects); }
  function battleHost(d) { return teacher() && d.ownerUid == request.auth.uid && owner(d.classCode) && member().permissions.get('quiz-battle.html',true) == true; }
  function validBattle(d) {
   return d.keys().hasOnly(['ownerUid','classCode','title','course','yearGroup','mode','phase','round','total','seconds','question','correct','explanation','standings','playerCount','startedAt','createdAt','updatedAt'])
    && d.title is string && d.title.size() > 0 && d.title.size() <= 80
    && d.course is string && d.course.size() > 0 && d.course.size() <= 120 && d.yearGroup in [7,8,9,10,11,12]
    && ((d.yearGroup <= 10 && d.course == 'Science') || (d.yearGroup >= 11 && d.course != 'Science'))
    && d.mode in ['individual','teams'] && d.phase in ['lobby','question','scoring','reveal','finished']
    && d.total is int && d.total >= 1 && d.total <= 50 && d.round is int && d.round >= 0 && d.round < d.total
    && d.seconds in [20,30,45,60] && d.playerCount is int && d.playerCount >= 0 && d.playerCount <= 100
    && d.standings is list && d.standings.size() <= 100 && d.correct is int && d.correct >= -1 && d.correct <= 3
    && d.explanation is string && d.explanation.size() <= 1000 && d.question is map && d.question.keys().hasOnly(['prompt','options'])
    && d.question.prompt is string && d.question.prompt.size() <= 2000 && d.question.options is list
    && (d.question.options.size() == 0 || (d.question.options.size() >= 2 && d.question.options.size() <= 4 && d.question.options[0] is string && d.question.options[1] is string && d.question.options[0].size() <= 300 && d.question.options[1].size() <= 300 && (d.question.options.size() < 3 || (d.question.options[2] is string && d.question.options[2].size() <= 300)) && (d.question.options.size() < 4 || (d.question.options[3] is string && d.question.options[3].size() <= 300))))
    && d.createdAt is timestamp && d.startedAt is timestamp && d.updatedAt is timestamp;
  }
  function validBattleTransition(before,after) {
   return (before.phase == 'lobby' && ((after.phase == 'question' && after.round == 0 && before.playerCount > 0) || after.phase == 'finished'))
    || (before.phase == 'question' && after.phase == 'scoring' && after.round == before.round)
    || (before.phase == 'scoring' && after.phase == 'reveal' && after.round == before.round)
    || (before.phase == 'reveal' && ((after.phase == 'question' && after.round == before.round + 1) || (after.phase == 'finished' && after.round == before.round)));
  }
  match /quizBattles/{code} {
   allow get: if (teacher() && (!exists(/databases/$(database)/documents/quizBattles/$(code)) || (battleHost(resource.data) && battleFresh(resource.data)))) || (battleStudent(resource.data) && battleFresh(resource.data));
   allow list, delete: if false;
   allow create: if code.matches('^[A-HJ-NP-Z2-9]{8}$') && battleHost(request.resource.data) && validBattle(request.resource.data)
    && request.resource.data.phase == 'lobby' && request.resource.data.round == 0 && request.resource.data.playerCount == 0
    && request.resource.data.correct == -1 && request.resource.data.standings == [] && request.resource.data.question == {'prompt':'','options':[]}
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.startedAt == request.time;
   allow update: if battleFresh(resource.data) && (
    (battleHost(resource.data) && validBattle(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','round','question','correct','explanation','standings','startedAt','updatedAt'])
     && validBattleTransition(resource.data,request.resource.data) && request.resource.data.updatedAt == request.time
     && (request.resource.data.phase != 'question' || (request.resource.data.startedAt == request.time && request.resource.data.correct == -1 && request.resource.data.explanation == '' && request.resource.data.question.options.size() >= 2)))
    || (battleStudent(resource.data) && resource.data.phase == 'lobby' && resource.data.playerCount < 100
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount']) && request.resource.data.playerCount == resource.data.playerCount + 1
     && !exists(/databases/$(database)/documents/quizBattles/$(code)/players/$(request.auth.uid))
     && existsAfter(/databases/$(database)/documents/quizBattles/$(code)/players/$(request.auth.uid)))
   );
   match /private/{privateId} {
    allow get: if battleHost(battle(code)) && battleFresh(battle(code));
    allow create: if privateId == 'deck' && battleHost(getAfter(/databases/$(database)/documents/quizBattles/$(code)).data)
     && getAfter(/databases/$(database)/documents/quizBattles/$(code)).data.createdAt == request.time
     && request.resource.data.keys().hasOnly(['questions']) && request.resource.data.questions is list
     && request.resource.data.questions.size() == getAfter(/databases/$(database)/documents/quizBattles/$(code)).data.total;
    allow list, update, delete: if false;
   }
   match /players/{uid} {
    allow get: if battleFresh(battle(code)) && (battleHost(battle(code)) || (battleStudent(battle(code)) && request.auth.uid == uid));
    allow list: if battleHost(battle(code)) && battleFresh(battle(code));
    allow create: if battleStudent(battle(code)) && battleFresh(battle(code)) && request.auth.uid == uid && battle(code).phase == 'lobby'
     && request.resource.data.keys().hasOnly(['nickname','team','joinedAt']) && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 24
     && request.resource.data.joinedAt == request.time && request.resource.data.team is int
     && ((battle(code).mode == 'individual' && request.resource.data.team == -1) || (battle(code).mode == 'teams' && request.resource.data.team >= 0 && request.resource.data.team <= 3))
     && getAfter(/databases/$(database)/documents/quizBattles/$(code)).data.playerCount == battle(code).playerCount + 1;
    allow update, delete: if false;
   }
   match /answers/{answerId} {
    allow get: if battleFresh(battle(code)) && (battleHost(battle(code)) || (battleStudent(battle(code)) && answerId == string(battle(code).round) + '_' + request.auth.uid));
    allow list: if battleHost(battle(code)) && battleFresh(battle(code));
    allow create: if battleStudent(battle(code)) && battleFresh(battle(code)) && battle(code).phase == 'question'
     && exists(/databases/$(database)/documents/quizBattles/$(code)/players/$(request.auth.uid))
     && request.resource.data.keys().hasOnly(['uid','round','choice','createdAt']) && request.resource.data.uid == request.auth.uid
     && request.resource.data.round == battle(code).round && answerId == string(battle(code).round) + '_' + request.auth.uid
     && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < battle(code).question.options.size()
     && request.resource.data.createdAt == request.time && request.time >= battle(code).startedAt
     && request.time <= battle(code).startedAt + duration.value(battle(code).seconds,'s');
    allow update, delete: if false;
   }
  }

  // Signed-in site activity is visible only to the administrator.
  function validActivityUser(d) {
   return d.keys().hasOnly(['displayName','role','lastSignInMs','lastSeenAt','page'])
    && d.displayName is string && d.displayName.size() <= 60
    && d.displayName == (exists(/databases/$(database)/documents/members/$(request.auth.uid)) ? member().displayName : 'User')
    && d.role == (exists(/databases/$(database)/documents/members/$(request.auth.uid)) ? member().role : 'user')
    && d.lastSignInMs is number && d.lastSignInMs >= 0 && d.lastSignInMs <= 4102444800000
    && d.lastSeenAt == request.time && d.page is string && d.page.size() <= 160;
  }
  match /activityUsers/{uid} {
   allow get: if isAdmin() || (signedIn() && uid == request.auth.uid);
   allow list: if isAdmin();
   allow create, update: if signedIn() && uid == request.auth.uid && validActivityUser(request.resource.data);
   allow delete: if false;
  }
  match /activityEvents/{eventId} {
   allow read: if isAdmin();
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','sessionId','kind','page','title','lessonId','lessonTitle','course','yearGroup','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 40
    && request.resource.data.kind in ['page_view','lesson_view']
    && request.resource.data.page is string && request.resource.data.page.size() <= 160
    && request.resource.data.title is string && request.resource.data.title.size() <= 180
    && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 160
    && request.resource.data.lessonTitle is string && request.resource.data.lessonTitle.size() <= 180
    && request.resource.data.course is string && request.resource.data.course.size() <= 120
    && request.resource.data.yearGroup is string && request.resource.data.yearGroup.size() <= 2
    && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }


  // Reports are private to their author and the administrator.
  match /contentReports/{reportId} {
   allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow create: if signedIn() && (active() || isAdmin())
    && request.resource.data.keys().hasOnly(['uid','displayName','role','category','details','status','adminNote','kind','contentId','title','subject','year','unit','section','url','excerpt','createdAt','updatedAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
    && request.resource.data.displayName == (exists(/databases/$(database)/documents/members/$(request.auth.uid)) ? member().displayName : 'Admin')
    && request.resource.data.role == (isAdmin() ? 'admin' : member().role)
    && request.resource.data.category in ['Incorrect question','Incorrect answer or marking guide','Missing information','Image or diagram error','Typing or formatting error','Technical problem','Other']
    && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 2000
    && request.resource.data.status == 'open' && request.resource.data.adminNote == ''
    && request.resource.data.kind in ['question','lesson','page']
    && request.resource.data.contentId is string && request.resource.data.contentId.size() <= 180
    && request.resource.data.title is string && request.resource.data.title.size() <= 180
    && request.resource.data.subject is string && request.resource.data.subject.size() <= 120
    && request.resource.data.year in [0,7,8,9,10,11,12]
    && request.resource.data.unit is string && request.resource.data.unit.size() <= 160
    && request.resource.data.section is int && request.resource.data.section >= 0 && request.resource.data.section <= 2000
    && request.resource.data.url is string && request.resource.data.url.size() <= 1500
    && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 1500
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
   allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','updatedAt'])
    && request.resource.data.status in ['open','in_review','resolved','dismissed']
    && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 1000
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Subject participation XP stays inside the student's own classes.
  match /classes/{code}/subjectLeaderboards/{scope}/students/{uid} {
   allow read: if owner(code) || enrolled(code) || isAdmin();
   allow create, update: if enrolled(code) && uid == request.auth.uid
    && scope.matches('^[a-z0-9-]{1,100}$')
    && request.resource.data.keys().hasOnly(['displayName','xp','level','subject','updatedAt'])
    && request.resource.data.displayName == member().displayName
    && request.resource.data.subject is string && request.resource.data.subject.size() <= 120
    && ((member().yearGroup <= 10 && request.resource.data.subject == 'Science') || request.resource.data.subject in member().subjects)
    && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000000
    && request.resource.data.level is int && request.resource.data.level == int(request.resource.data.xp / 250) + 1
    && request.resource.data.updatedAt == request.time
    && (!exists(/databases/$(database)/documents/classes/$(code)/subjectLeaderboards/$(scope)/students/$(uid)) || request.resource.data.xp >= resource.data.xp);
   allow delete: if false;
  }

  // Shared participation standings contain no email, class membership or activity details.
  function validWebsitePoints(d) {
   return d.displayName == member().displayName
    && d.xp is int && d.xp >= 0 && d.xp <= 10000000
    && d.level is int && d.level == int(d.xp / 250) + 1
    && d.updatedAt == request.time;
  }
  function websiteSubjectScope(subject) {
   let scopes = {'Science':'science','Geography ATAR':'geography','Business Management and Enterprise ATAR':'business-management-and-enterprise','Accounting and Finance ATAR':'accounting-and-finance','Physics ATAR':'physics','Chemistry ATAR':'chemistry','Biology ATAR':'biology','Human Biology ATAR':'human-biology','Psychology ATAR':'psychology','Mathematics Methods ATAR':'mathematics-methods','Mathematics Specialist ATAR':'mathematics-specialist','Mathematics Applications ATAR':'mathematics-applications','English ATAR':'english','Physical Education Studies ATAR':'physical-education-studies'};
   return scopes[subject];
  }
  function validRosterSeed(uid,d) {
   let target = get(/databases/$(database)/documents/members/$(uid)).data;
   return isAdmin() && target.status == 'active' && target.registrationVersion == 2
    && target.role in ['student','teacher'] && d.displayName == target.displayName
    && d.xp == 0 && d.level == 1 && d.updatedAt == request.time;
  }
  match /websiteLeaderboard/{uid} {
   allow create: if validRosterSeed(uid,request.resource.data) && request.resource.data.keys().hasOnly(['displayName','xp','level','updatedAt']);
   allow read: if isAdmin() || active();
   allow create, update: if active() && request.auth.uid == uid
    && member().role in ['student','teacher']
    && request.resource.data.keys().hasOnly(['displayName','xp','level','updatedAt'])
    && validWebsitePoints(request.resource.data)
    && (!exists(/databases/$(database)/documents/websiteLeaderboard/$(uid)) || request.resource.data.xp >= resource.data.xp);
   allow delete: if false;
  }
  match /subjectLeaderboards/{scope}/participants/{uid} {
   allow create: if validRosterSeed(uid,request.resource.data)
    && request.resource.data.keys().hasOnly(['displayName','xp','level','subject','updatedAt'])
    && scope == websiteSubjectScope(request.resource.data.subject)
    && ((get(/databases/$(database)/documents/members/$(uid)).data.yearGroup <= 10 && request.resource.data.subject == 'Science')
     || request.resource.data.subject in get(/databases/$(database)/documents/members/$(uid)).data.subjects);
   allow read: if isAdmin() || active();
   allow create, update: if active() && request.auth.uid == uid
    && member().role in ['student','teacher']
    && request.resource.data.keys().hasOnly(['displayName','xp','level','subject','updatedAt'])
    && request.resource.data.subject is string
    && scope == websiteSubjectScope(request.resource.data.subject)
    && (member().role == 'teacher'
     || (member().yearGroup <= 10 && request.resource.data.subject == 'Science')
     || request.resource.data.subject in member().subjects)
    && validWebsitePoints(request.resource.data)
    && (!exists(/databases/$(database)/documents/subjectLeaderboards/$(scope)/participants/$(uid)) || request.resource.data.xp >= resource.data.xp);
   allow delete: if false;
  }

  match /{document=**} { allow read, write: if false; }
 }
}





