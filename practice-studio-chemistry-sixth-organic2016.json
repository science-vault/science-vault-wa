 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":8,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Multiple choice"],"figures":0,"hash":"62fe456e478473da46b5d40ee8137d825e83789cf859c43440cac41d33fc380b"},{"id":"chemistry-sixth-organic2016-mc-9","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":9,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Multiple choice","marks":1,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"How many of the following compounds can exhibit geometric (cis-trans) isomerism? 1,1 – dibromo propene 1,2 – dibromo propene 2,3 – dibromo propene 3,3 – dibromo propene","html":"<div><p>How many of the following compounds can exhibit geometric\n(cis-trans) isomerism?</p>\n<ul>\n<li><p>1,1 – dibromo propene</p></li>\n</ul>\n<ul>\n<li><p>1,2 – dibromo propene</p></li>\n</ul>\n<ul>\n<li><p>2,3 – dibromo propene</p></li>\n</ul>\n<ul>\n<li><p>3,3 – dibromo propene</p></li>\n</ul>\n</div>","answerHtml":"<p>Supplied key: <strong>A</strong>.</p><div><p>1</p>\n</div>","options":["1","2","3","4"],"optionsHtml":["<div><p>1</p>\n</div>","<div><p>2</p>\n</div>","<div><p>3</p>\n</div>","<div><p>4</p>\n</div>"],"correctAnswer":0,"markingMode":"automatic","solutionOrigin":"supplied","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":9,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Multiple choice"],"figures":0,"hash":"a4903709eb22694d93c721d59135ccd8002eba6f6f00bdc04fc23e42dd6757a4"},{"id":"chemistry-sixth-organic2016-mc-10","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":10,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Multiple choice","marks":1,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"A colourless organic liquid (X) is reacted with an acidified potassium permanganate solution. The product is a liquid (Y). The liquid (X) and liquid (Y) are then reacted to produce a liquid (Z). Which of the following general formulas represents the liquid (Y)? [R represents the rest of the molecule.]","html":"<div><p>A colourless organic liquid (X) is reacted with an acidified\npotassium permanganate solution. The product is a liquid (Y). The liquid\n(X) and liquid (Y) are then reacted to produce a liquid (Z).</p>\n<p>Which of the following general formulas represents the liquid\n(Y)?</p>\n<p>[R represents the rest of the molecule.]</p>\n</div>","answerHtml":"<p>Supplied key: <strong>D</strong>.</p><div><p>RCOOH</p>\n</div>","options":["RCH2OH","RCOR","RCOOR","RCOOH"],"optionsHtml":["<div><p>RCH<sub>2</sub>OH</p>\n</div>","<div><p>RCOR</p>\n</div>","<div><p>RCOOR</p>\n</div>","<div><p>RCOOH</p>\n</div>"],"correctAnswer":3,"markingMode":"automatic","solutionOrigin":"supplied","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":10,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Multiple choice"],"figures":0,"hash":"19fb237775f11d38e268c140813397f27ecab1eac9525ed8428ca1844a06b134"},{"id":"chemistry-sixth-organic2016-written-1","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":1,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":6,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"Give the IUPAC name of each labelled structure (1 mark each; 6 marks).","html":"<div><p>Give the IUPAC name of each labelled structure (1 mark each; 6 marks).</p><img src=\"assets/chemistry/practice-import-sixth/86a05196282dfac5b42ab893.webp\" alt=\"Original organic structures (a)–(f)\" data-word-width-px=\"620\" style=\"max-width:100%;height:auto\" data-word-max-height=\"7\"></div>","answerHtml":"<p><strong>Teacher review required.</strong> The first handwritten name is unclear/inconsistent with the longest chain. Editable names are checked against the paper diagrams; structure (a) has a seven-carbon parent chain.</p><p>(a) 4-ethyl-2-methylheptane. (b) 2,3-dichloropropanoic acid. (c) Ethyl butanoate. (d) 1,3-dimethylbenzene. (e) cis-pent-2-ene (Z-pent-2-ene). (f) 2-methylbutan-1-amine.</p><p>One mark per name. See the supplied key image for the original handwritten responses; the longest chain in (a) contains seven carbons.</p><img src=\"assets/chemistry/practice-import-sixth/9c749aed9391557af955b5c5.webp\" alt=\"Original handwritten organic marking key — 5\" data-word-width-px=\"620\" style=\"max-width:100%;height:auto\" data-word-max-height=\"7\">","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":1,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":["The first handwritten name is unclear/inconsistent with the longest chain. Editable names are checked against the paper diagrams; structure (a) has a seven-carbon parent chain."],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":1,"hash":"cdf80c29e8da7c3401e7e32d201ba8283de1cda861c2f2847fdbec93c34db036"},{"id":"chemistry-sixth-organic2016-written-2","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":2,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":8,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"Give the full structural formula for each organic chemical, including all hydrogen atoms (8 marks).(a) 5-ethyl-3-heptanone(b) 2-chloro-5-methyloctanamine(c) 2-ethylhexyl ethanoate(d) 4,4-diethyloctanal(e) trans-3-heptene(f) 1,1-dichloro-cis-2-butene(g) 3,4-diiodo-2-methyl-1-pentanamide(h) 3-ethyl-5,5-dimethylheptan-4-one","html":"<div><p>Give the full structural formula for each organic chemical, including all hydrogen atoms (8 marks).</p><p>(a) 5-ethyl-3-heptanone</p><p>(b) 2-chloro-5-methyloctanamine</p><p>(c) 2-ethylhexyl ethanoate</p><p>(d) 4,4-diethyloctanal</p><p>(e) trans-3-heptene</p><p>(f) 1,1-dichloro-cis-2-butene</p><p>(g) 3,4-diiodo-2-methyl-1-pentanamide</p><p>(h) 3-ethyl-5,5-dimethylheptan-4-one</p></div>","answerHtml":"<p><strong>Teacher review required.</strong> The source name octanamine lacks an amine locant; the supplied drawing/condensed reference assumes octan-1-amine.</p><p>Editable condensed references follow; the student must draw all hydrogen atoms and the correct geometry where requested.</p><p>(a) CH₃CH₂C(=O)CH₂CH(CH₂CH₃)CH₂CH₃.</p><p>(b) H₂NCH₂CH(Cl)CH₂CH₂CH(CH₃)CH₂CH₂CH₃ (taking the unlocated amine as octan-1-amine).</p><p>(c) CH₃C(=O)OCH₂CH(CH₂CH₃)CH₂CH₂CH₂CH₃.</p><p>(d) OHCCH₂CH₂C(CH₂CH₃)₂CH₂CH₂CH₂CH₃.</p><p>(e) trans-CH₃CH₂CH=CHCH₂CH₂CH₃.</p><p>(f) cis-CHCl₂CH=CHCH₃ (CHCl₂ and CH₃ on the same side of the double bond).</p><p>(g) H₂NC(=O)CH(CH₃)CH(I)CH(I)CH₃.</p><p>(h) CH₃CH₂CH(CH₂CH₃)C(=O)C(CH₃)₂CH₂CH₃.</p><p>One mark per complete structure.</p><img src=\"assets/chemistry/practice-import-sixth/814f0851910f3c8adfdddaec.webp\" alt=\"Original handwritten organic marking key — 6\" data-word-width-px=\"620\" style=\"max-width:100%;height:auto\" data-word-max-height=\"7\">","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":2,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":["The source name octanamine lacks an amine locant; the supplied drawing/condensed reference assumes octan-1-amine."],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":0,"hash":"9c3d2a2a368b08a6355ed5df4c1ae8fabd585b2e4e3c77b3e0d2f4151f8d530c"},{"id":"chemistry-sixth-organic2016-written-3","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":3,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":8,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"For each of the situations described below, write a balanced redox reaction showing the changes that take place (there is no need to show the phase of the chemicals); Give a brief observation of any major colour change that would be observed in any of the coloured reagents used to bring about the reaction. (a) Acidified potassium permanganate solution is added to pentan-2-ol. (b) Limited dilute acidified potassium dichromate is added to propan-1-ol (assume incomplete oxidation). [8 marks]","html":"<div><p>For each of the situations described below, write a balanced redox\nreaction showing the changes that take place (there is no need to show\nthe phase of the chemicals);</p>\n<blockquote>\n<p>Give a brief observation of any major colour change that would be\nobserved in any of the coloured reagents used to bring about the\nreaction.</p>\n</blockquote>\n<p>(a) Acidified potassium permanganate solution is added to\npentan-2-ol.</p>\n<p>(b) Limited <strong>dilute</strong> acidified potassium dichromate is\nadded to propan-1-ol (assume incomplete oxidation).</p>\n<p>[8 marks]</p>\n</div>","answerHtml":"<p>(a) Oxidation: CH₃CH(OH)CH₂CH₂CH₃ → CH₃COCH₂CH₂CH₃ + 2H⁺ + 2e⁻. Reduction: MnO₄⁻ + 8H⁺ + 5e⁻ → Mn²⁺ + 4H₂O.</p><p>Overall: 5CH₃CH(OH)CH₂CH₂CH₃ + 2MnO₄⁻ + 6H⁺ → 5CH₃COCH₂CH₂CH₃ + 2Mn²⁺ + 8H₂O. Purple permanganate becomes colourless/pale pink.</p><p>(b) Oxidation: CH₃CH₂CH₂OH → CH₃CH₂CHO + 2H⁺ + 2e⁻. Reduction: Cr₂O₇²⁻ + 14H⁺ + 6e⁻ → 2Cr³⁺ + 7H₂O.</p><p>Overall: 3CH₃CH₂CH₂OH + Cr₂O₇²⁻ + 8H⁺ → 3CH₃CH₂CHO + 2Cr³⁺ + 7H₂O. Orange dichromate becomes green. Propanal is collected under conditions preventing further oxidation.</p><p>Suggested allocation: balanced half-equations, overall equation and observation for each reaction, 4 marks each.</p><img src=\"assets/chemistry/practice-import-sixth/6436684c2bed3fd5d59c2f57.webp\" alt=\"Original handwritten organic marking key — 7\" data-word-width-px=\"620\" style=\"max-width:100%;height:auto\" data-word-max-height=\"7\">","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":3,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":0,"hash":"297320044e8d38abb39a6a8d0741ea6d80729de018d2865850eac312b494eb1a"},{"id":"chemistry-sixth-organic2016-written-4","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":4,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":8,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"DRAW and NAME the major organic PRODUCT or PRODUCTS in the following reactions assuming appropriate conditions. NB. No balancing is required. a. Propanoic acid and potassium hydroxide solution. b. Cyclohexene and bromine. c. Methanol and hexanoic acid. d. Ethane and chlorine. [8 marks]","html":"<div><p>DRAW and NAME the major organic PRODUCT or PRODUCTS in the\nfollowing reactions assuming appropriate conditions. NB. No balancing is\nrequired.</p>\n<p>a. Propanoic acid and potassium hydroxide solution.</p>\n<p>b. Cyclohexene and bromine.</p>\n<p>c. Methanol and hexanoic acid.</p>\n<p>d. Ethane and chlorine.</p>\n<p>[8 marks]</p>\n</div>","answerHtml":"<p>(a) Potassium propanoate, CH₃CH₂COO⁻K⁺; water is the inorganic product.</p><p>(b) 1,2-dibromocyclohexane (bromine adds across the C=C bond).</p><p>(c) Methyl hexanoate, CH₃(CH₂)₄C(=O)OCH₃; water is also formed.</p><p>(d) Chloroethane, CH₃CH₂Cl; HCl is also formed, under UV light.</p><p>One mark for each organic product structure and one for its name. Further substitution is possible with excess chlorine; the intended first substitution product is shown.</p><img src=\"assets/chemistry/practice-import-sixth/45077e394e5d9a3bac2090e0.webp\" alt=\"Original handwritten organic marking key — 8\" data-word-width-px=\"620\" style=\"max-width:100%;height:auto\" data-word-max-height=\"7\">","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":4,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":0,"hash":"5cb8895d9562359cb4a9bc82095ad3b86606b4d49d162abf3a427cb385b4dd49"},{"id":"chemistry-sixth-organic2016-written-5","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":5,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":6,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"(a) An unknown organic compound contains only carbon, hydrogen and oxygen. A 0.275g sample of the compound was combusted in excess oxygen to yield 0.403g of carbon dioxide and 0.165g of water. Determine the empirical formula of the compound. Given that a 1.50g sample of the same compound, when vapourised, occupied 498.5 mL at 295K and 123.0 kPa, determine the molecular formula of the compound. (R = 8.314 J K-1 mol-1) (b) Had the organic compound turned blue litmus pink, draw its molecular structure and name it. [6 marks]","html":"<div><p>(a) An unknown organic compound contains only carbon, hydrogen and\noxygen. A 0.275g sample of the compound was combusted in excess oxygen\nto yield 0.403g of carbon dioxide and 0.165g of water.</p>\n<blockquote>\n<p>Determine the empirical formula of the compound. Given that a 1.50g\nsample of the same compound, when vapourised, occupied 498.5 mL at 295K\nand 123.0 kPa, determine the molecular formula of the compound.</p>\n</blockquote>\n<p>(R = 8.314 J K-1 mol-1)</p>\n<p>(b) Had the organic compound turned blue litmus pink, draw its\nmolecular structure and name it.</p>\n<p>[6 marks]</p>\n</div>","answerHtml":"<p>(a) n(C) = 0.403/44.01 ≈ 0.00916 mol; n(H) = 2(0.165/18.016) ≈ 0.0183 mol.</p><p>Mass O ≈ 0.275 − (0.00916 × 12.01) − (0.0183 × 1.008) ≈ 0.1465 g; n(O) ≈ 0.00916 mol.</p><p>C:H:O ≈ 1:2:1, so empirical formula CH₂O.</p><p>n(gas) = PV/RT = (123.0 × 0.4985)/(8.314 × 295) ≈ 0.0250 mol; M ≈ 1.50/0.0250 = 60.0 g mol⁻¹.</p><p>M/empirical mass ≈ 60.0/30.0 = 2; molecular formula C₂H₄O₂.</p><p>(b) Ethanoic acid: CH₃C(=O)OH. Total 6 marks; retain the supplied guide’s allocation.</p>","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":5,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":0,"hash":"4c93e2a369b0b61cda366827448599e3506160649beb998466f9e2e97d8be213"},{"id":"chemistry-sixth-organic2016-written-6","subject":"Chemistry","year":12,"examYear":2016,"units":"3 & 4","number":6,"source":"Organic Chemistry — Test 6 (All Saints, 2016)","section":"Short answer","marks":4,"topics":["Organic chemistry"],"subtopics":["Organic Chemistry"],"mixed":false,"text":"The boiling point of ethanol, CH3CH2OH, is lower than the boiling point of butan-1-ol, CH3CH2CH2CH2OH, but the solubility of ethanol in water is higher than the solubility of butan-1-ol in water. Explain these observations. [4 marks]","html":"<div><p>The boiling point of ethanol, CH<sub>3</sub>CH<sub>2</sub>OH, is\nlower than the boiling point of butan-1-ol,</p>\n<blockquote>\n<p>CH<sub>3</sub>CH<sub>2</sub>CH<sub>2</sub>CH<sub>2</sub>OH, but the\nsolubility of ethanol in water is higher than the solubility of\nbutan-1-ol in water. Explain these observations.</p>\n</blockquote>\n<blockquote>\n<p>[4 marks]</p>\n</blockquote>\n</div>","answerHtml":"<p>Both alcohols can form hydrogen bonds. Butan-1-ol has a larger electron cloud and stronger dispersion forces than ethanol, requiring more energy to separate its molecules and giving a higher boiling point (2 marks).</p><p>Both hydroxyl groups hydrogen-bond with water. Ethanol has a smaller non-polar hydrocarbon portion, so the favourable interactions with water are more significant; the longer hydrophobic chain makes butan-1-ol less soluble (2 marks).</p>","options":[],"optionsHtml":[],"correctAnswer":null,"markingMode":"manual","solutionOrigin":"supplied-with-clarification","sourceFile":"2016 Test 6 Organic Chemistry 1.docx","sourcePath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1.docx","sourceBlobSHA":"1ca8cfc67056fc1edb3c1efd0c14b844e9bc37a8","sourceSHA256":"ab414ae72a43f7484b13b6a9da1d6b4c599fe5db7cd6ae07b51841cdda1e63ee","sourceKeyFile":"2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyPath":"resources/ATAR/Chemistry/Assessments/12/All Saints/2016/2016 Test 6 Organic Chemistry 1 Answers.pdf","sourceKeyBlobSHA":"d7068a0743d70801a658ab018160a4c883cd67d2","sourceKeySHA256":"eefd319a9c77fe46045e31e47d1fd872dbec7eb2e61dc8614388d2183f277e24","sourceKeyNumber":6,"bankFile":"practice-studio-chemistry-sixth-organic2016.json","addedAt":"2026-11-07T05:47:40.476409Z","editableText":true,"questionFormat":"native-text","fontFamily":"Arial","fontSizePt":12,"responseLines":0,"sourceReviewNotes":[],"sourceTextFile":"2016 Test 6 Organic Chemistry 1.docx","types":["Short answer"],"figures":0,"hash":"2a1d9df71000a685014510d08497b1fd3421afd0c615a20cfbfc3913a2346f98"}]